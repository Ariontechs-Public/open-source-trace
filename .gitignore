# Knowledge-graph index: codegraph replaces the old committed graphify-out/.
# `.codegraph/` is a live, machine-generated SQLite index living inside each
# submodule — local tooling state, regenerated via `codegraph init <path>`,
# never committed. (Submodules have their own git boundary, but ignore here too.)
.codegraph/

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Tooling state (Claude Code project-local, direnv)
# Ignore Claude Code's runtime state, but DO commit settings.json (project policy).
# NOTE: `.claude/*` (not `.claude/`) — directory ignore would prevent git from descending,
# making the negation below ineffective.
.claude/*
!.claude/settings.json
.envrc

# Logs
*.log

# Node (if scripts/ ever needs it)
node_modules/

# Python (if scripts/ ever needs it)
__pycache__/
*.pyc
.venv/
venv/

# Local env / secrets
.env
.env.local
.env.*.local
